# protocols/triz.think — TRIZ-guided ideation protocol (issue #94).
#
# Contradiction-driven brainstorm: no candidate is generated before the
# physical contradiction is stated (the behavior contract is checkable
# from the event log — hypothesize never precedes challenge), and every
# candidate leaves the spectrum classified as pattern | compromise |
# antipattern for its discipline. Compromise is a legal label, but it
# must be labeled, not silently shipped.
#
# The solution spectrum gets its width from two search branches: the
# discipline's own hits and one deliberately remote field (level-4
# transfer — the strongest solutions travel from a remote field). The
# classified spectrum persists under the caller's kb_key so a
# discipline's patterns and antipatterns accumulate across runs
# (KB.triz: remember here, recall from the next session).
#
# Method source: github.com/AlexKay28/triz — ch. 2 (contradictions),
# ch. 3 (IFR), ch. 13-14 (principles, patterns, antipatterns).
#
# v1 composes registered commands only (no new language surface); the
# two search branches are plain steps — a SCATTER/GATHER form can come
# later without changing the contract. Sealed like any program: callers
# re-seal after this file changes (composite seal hashing is NOT
# implemented). Must not CALL itself — child chains are depth-bounded.

PROGRAM triz VERSION 1.0

INPUT
    G.task = "one-line inventive problem statement"
    G.done = "every candidate classified as pattern, compromise or antipattern; zero unclassified"
    C.discipline = "the field whose solution spectrum is mined"
    C.remote = "a deliberately remote field raided for level-4 transfers"
    C.ifr_question = "state the IFR: the function performs itself with what is already on site; name what exactly prevents it"
    C.moves_question = "propose concrete moves that remove the stated contradiction; use the discipline hits and the remote-field transfers; name the principle behind each move"
    C.criteria = "pattern removes the contradiction; compromise softens it; antipattern widens it; prefer higher ideality"
    C.kb_key = "triz/spectrum"

step.frame: DO define(request = G.task) -> G.plan
step.claim: DO summarize(source_refs = [G.plan], budget = 200) -> ART.claim
step.contra: DO challenge(claim = ART.claim, evidence = [ART.claim]) -> V.contradiction
step.ideal: DO hypothesize(question = C.ifr_question, evidence = [V.contradiction]) -> E.ifr
step.known: DO search(query = G.task, scope = C.discipline) -> E.known
step.raid: DO search(query = G.task, scope = C.remote) -> E.raids
step.moves: DO hypothesize(question = C.moves_question, evidence = [V.contradiction, E.known, E.raids]) -> E.spectrum
step.classify: DO compare(options = E.spectrum, criteria = C.criteria) -> V.matrix
step.order: DO rank(options = E.spectrum, criteria = C.criteria) -> E.ordering
step.gate: DO verify(goal = G.done, evidence = [V.matrix, E.ordering, E.ifr]) -> V.result
DONE V.result == "resolved"
step.keep: DO remember(key = C.kb_key, value = V.matrix) -> K.spectrum
step.report: DO report(committed_refs = [V.result, V.matrix, E.ordering], format = "markdown") -> ART.report

RETURN V.contradiction, E.spectrum, V.matrix, E.ordering, K.spectrum, ART.report
