# Tikhon run for GitHub issue #1: support lists of typed references in arguments.

PROGRAM issue_01_refs_lists VERSION 1.0

INPUT
    G.goal = "Support lists of typed references in step arguments so one step can consume several produced nodes at once, written as a bracketed comma-separated list such as [E.a, E.b]"
    C.scope = "src/tikhon/syntax/parser.py, src/tikhon/syntax/model.py, src/tikhon/runtime/coordinator.py, tests/test_syntax.py, tests/test_coordinator.py"
    C.behavior = "A bracket argument containing only comma-separated typed references parses into a reference list; validation rejects unknown refs inside lists with a location; the coordinator resolves each listed ref through the shared values mapping so workers receive a real Python list; empty, nested, and mixed brackets are rejected clearly; single refs, JSON literals, and the multi-target arrow syntax stay unchanged; canonical JSON and the seal digest stay deterministic"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.sites
step.read: DO fetch(resource_refs = E.sites) -> ART.sources
step.analyze: DO extract(artifact = ART.sources, schema = "argument_resolution") -> E.findings
step.design: DO summarize(source_refs = E.findings, budget = 4000) -> P.design
step.patch: DO report(committed_refs = P.design, format = "python_patch") -> ART.patch
step.check: DO check(artifact = ART.patch, criteria = C.behavior) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN ART.patch, V.tests, V.result
