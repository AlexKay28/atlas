PROGRAM issue_15_registry_digest VERSION 1.0

INPUT
    G.goal = "Registry digest in RUN_STARTED plus hyphen-tolerant program names"
    C.scope = "src/tikhon/registry (digest helper only), src/tikhon/runtime/coordinator.py (RUN_STARTED metadata and payload), src/tikhon/syntax/parser.py (PROGRAM name pattern), tests/test_syntax.py, tests/test_coordinator.py, tests/test_audit.py, .opencode/skills/tikhon-demo/SKILL.md"
    C.done = "registry_digest() deterministic over sorted (name, version, effect_class, execution, minimum_tier) summaries; SequentialCoordinator records it in create_run metadata and the RUN_STARTED payload; audit stays clean on legacy runs without a digest; PROGRAM names accept hyphens after the first character while step ids keep underscores; full pytest suite passes"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.patterns
step.design: DO extract(artifact = E.patterns, schema = "digest_formula_and_grammar_delta") -> E.design
step.patch: DO summarize(source_refs = E.design, budget = 8000) -> P.patch
step.check: DO check(artifact = P.patch, criteria = C.done) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN P.patch, V.tests, V.result
