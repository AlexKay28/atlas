PROGRAM runtime_failure_refactor VERSION 1.0

INPUT
    G.goal = "Normalize coordinator failure handling without changing successful execution"
    C.scope = "src/thinklang/runtime/coordinator.py and tests/test_coordinator.py"
    C.behavior = "All runtime failures terminate atomically; validation events are truthful; target mapping is unambiguous; no terminal run has active or pending tasks"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.candidates
step.read: DO fetch(resource_refs = E.candidates) -> ART.sources
step.analyze: DO extract(artifact = ART.sources, schema = "failure_paths") -> E.findings
step.design: DO summarize(source_refs = E.findings, budget = 4000) -> P.refactor
step.patch: DO report(committed_refs = P.refactor, format = "python_patch") -> ART.patch
step.check: DO check(artifact = ART.patch, criteria = C.behavior) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN ART.patch, V.tests, V.result
