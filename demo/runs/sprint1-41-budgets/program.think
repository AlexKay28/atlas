# Tikhon run for GitHub issue #41: Budgets, take 2
# (resume drops the gate; wedged workers block finalization; concurrent
# path bypasses claims; token/attempt caps never enforced).
#
# Sealed BEFORE any source edit (tikhon protocol). Uses only the canonical
# grammar that exists at seal time: plain DO steps over all 23 registered
# commands, one SCATTER/GATHER bounded fan-out, one PAR MAX 3 block with
# heterogeneous branches (2 DO + 1 CALL), one runtime delegate authoring
# step, and one CALL protocol.framing line.

PROGRAM issue_41_budgets VERSION 1.0

INPUT
    G.goal = "Fix four enforcement holes in the budget story: (A) resume_run drops the budget gate — resumed runs execute gateless and BudgetGate has no elapsed-offset so the wall clock restarts; (B) wedged-worker wall-clock — a hung handler blocks execute() forever after the run was finalized failed, and per_invocation_deadline_seconds bounds nothing in wall-clock; (C) _drive_plan_concurrent takes no claims/workspace params — two parallel effectful steps share workspace_root with no claim, unlike PAR branches; (D) token/attempt caps never enforced — only max_seconds is checked, max_tokens is recorded but never summed or capped, max_attempts is un enforced at the coordinator layer"
    C.scope = "src/tikhon/budgets.py, src/tikhon/resume.py, src/tikhon/runtime/coordinator.py, tests/test_budgets.py, tests/test_resume.py, tests/test_budgets2.py, demo/runs/sprint1-41-budgets/"
    C.done = "All 760 pre-existing tests still pass; 6 new acceptance tests cover each item; budget=None path unchanged; git status shows only owned files"
    Q.acceptance = ["resume-remaining-deadline", "wedged-worker-wallclock", "concurrent-claims", "token-cap-run-finished", "max-attempts-refused", "budget-none-unchanged"]

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.sites
step.read: DO fetch(resource_refs = E.sites) -> ART.sources
step.analyze: DO extract(artifact = ART.sources, schema = "budget_enforcement") -> E.findings
step.decompose: DO decompose(goal = G.plan, protocol = "budget_fix") -> G.subgoals
step.hypothesize: DO hypothesize(question = G.goal, evidence = E.findings) -> H.theses
step.calculate: DO calculate(expression = "budget_enforcement_gap", values = {"holes": 4, "caps": 3, "paths": 6}) -> F.metrics
step.compare: DO compare(options = H.theses, criteria = C.done) -> V.compared
step.rank: DO rank(options = V.compared, criteria = C.done) -> R.ranked
step.challenge: DO challenge(claim = H.theses, evidence = E.findings) -> V.challenge
step.choose: DO choose(valid_options = R.ranked, evidence = V.challenge) -> D.choice
step.remember: DO remember(key = "issue41-budgets", value = D.choice) -> K.record
step.recall: DO recall(query = "issue41-budgets") -> K.recalled
step.solve: DO solve(problem = G.goal, domain = "budget_enforcement") -> U.solution
step.prove: DO prove(statement = C.done, language = "tikhon_contract") -> A.proof
step.review: DO review(artifact_refs = ART.sources, focus = "budget_caps") -> V.review
step.design: DO summarize(source_refs = V.review, budget = 6000) -> P.design
step.scatter_prepare: DO define(goal = Q.acceptance) -> Q.parts
SCATTER X.sample IN Q.parts MAX 4
  step.sample_rank: DO rank(options = X.sample, criteria = C.done) -> R.sample
GATHER sample_rank AS R.samples USING all
PAR MAX 3
    step.par_sites: DO search(query = G.plan, scope = C.scope) -> E.par_sites
    step.par_check: DO check(artifact = V.review, predicate = "evidence_committed") -> V.par_verdict
    CALL protocol.framing(request = G.plan, scope = C.scope) -> E.context, V.analysis
BARRIER -> E.par_sites, V.par_verdict, E.context, V.analysis
step.author: DO delegate(goal = G.plan, constraints = C.scope, max_steps = 6) -> OUT.plan, OUT.metrics
step.patch: DO edit(path = "src/tikhon/budgets.py", content = "ExecutionBudget gains max_total_tokens; BudgetGate accumulates spent tokens and checks cap") -> ART.patch
step.test: DO test(path = "tests/test_budgets2.py", timeout_seconds = 600) -> V.tests
step.check: DO check(artifact = V.tests, predicate = "suite_green") -> V.verdict
step.report: DO report(committed_refs = [V.verdict, F.metrics], format = "markdown") -> ART.report
step.verify: DO verify(goal = G.goal, evidence = [ART.patch, V.tests, R.samples]) -> V.result

RETURN P.design, V.verdict, V.result, R.samples, OUT.plan, OUT.metrics, F.metrics, V.analysis
