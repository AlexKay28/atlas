# Sealed before any source edit for issue #19 (external-driver claim bridge).
# Plain sequential steps (no IF/CALL/REVISE): every step is externally
# drivable through `tikhon ready` / `tikhon claim` / `tikhon submit` on top
# of the Wave 8 envelope round trip.

PROGRAM issue_19_driver_bridge VERSION 1.0

INPUT
    G.goal = "Build the agent-executable claim bridge so an external driver can ready, claim and submit Tikhon invocations with fencing tokens without holding the event store"
    C.scope = "src/tikhon/bridge.py, src/tikhon/cli.py, src/tikhon/runtime/events.py, tests/test_bridge.py"
    C.done = "tikhon ready/claim/submit drives a sealed run to succeeded externally; fresh claims fence a second driver; stale claims are reissued with attempt+1 and the old token rejects; wrong tokens append nothing; audit stays clean; full pytest suite passes"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.patterns
step.design: DO extract(artifact = E.patterns, schema = "claim_lifecycle_fencing_and_reissue") -> E.design
step.patch: DO summarize(source_refs = [E.design, C.scope], budget = 12000) -> P.patch
step.check: DO check(artifact = P.patch, criteria = C.done) -> V.tests
DONE V.tests == "pass"
step.verify: DO verify(goal = G.goal, evidence = [P.patch, V.tests]) -> V.result

RETURN G.plan, P.patch, V.tests, V.result
