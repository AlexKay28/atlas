# Tikhon run for GitHub issue #44: Envelope additive versioning policy
# Sealed BEFORE any source edit (tikhon protocol step 2). Uses only the
# canonical grammar: plain sequential DO steps over registered commands.
# Every argument is a single typed reference or a JSON literal.

PROGRAM sprint1_44_envelope_versioning VERSION 1.0

INPUT
    G.task = "Implement additive versioning policy for envelope schema: read-side tolerates unknown fields within v1, writers stay strict, schema_version != 1 fails with versioned error"
    C.scope = "src/tikhon/envelope.py, tests/test_envelope.py, demo/runs/sprint1-44-envelope-versioning/"
    C.done = "v1 envelope with one unknown field parses under compat policy; schema_version 2 fails with versioned error naming supported version; all existing envelope tests pass unchanged; roundtrip of strict writer output is identical before and after; full pytest suite green; only owned files changed"
    C.policy = "drop_unknown_on_read"

step.frame: DO define(request = G.task) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.candidates
step.read: DO fetch(resource_refs = E.candidates) -> ART.sources
step.analyze: DO extract(artifact = ART.sources, schema = "additive_versioning") -> E.findings
step.design: DO summarize(source_refs = E.findings, budget = 4000) -> P.design
step.implement: DO edit(path = "src/tikhon/envelope.py", content = "additive_policy_read_tolerant_writer_strict") -> ART.patch
step.test: DO test(path = "tests/test_envelope.py", timeout_seconds = 600) -> V.tests
step.check: DO check(artifact = V.tests, predicate = "suite_green") -> V.verdict
step.report: DO report(committed_refs = ART.patch, format = "markdown") -> OUT.solution
step.verify: DO verify(goal = G.task, evidence = V.tests) -> V.result

RETURN OUT.solution, V.result
