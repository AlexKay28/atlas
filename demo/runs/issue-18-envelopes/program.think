# Sealed before any source edit for issue #18 (task/result envelopes).
# Plain sequential steps (no IF/CALL/REVISE): every step is externally
# drivable through `tikhon next` / `tikhon submit` envelopes.

PROGRAM issue_18_envelopes VERSION 1.0

INPUT
    G.goal = "Define the task/result envelope protocol and drive a sequential external round trip"
    C.scope = "src/tikhon/envelope.py, src/tikhon/worker_adapter.py, src/tikhon/cli.py, tests/test_envelope.py"
    C.done = "TaskEnvelope and ResultEnvelope round trip through JSON with strict validation; ModelWorker builds its prompt from a TaskEnvelope and parses replies into ResultEnvelope; tikhon next/submit drives a full run externally; full pytest suite passes"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.patterns
step.design: DO extract(artifact = E.patterns, schema = "envelope_protocol_and_external_driver") -> E.design
step.patch: DO summarize(source_refs = [E.design, C.scope], budget = 12000) -> P.patch
step.check: DO check(artifact = P.patch, criteria = C.done) -> V.tests
DONE V.tests == "pass"
step.verify: DO verify(goal = G.goal, evidence = [P.patch, V.tests]) -> V.result

RETURN G.plan, P.patch, V.tests, V.result
