# Sealed before any source edit for issue #12 (protocol calls).
# CALL is not used here: it does not exist in the grammar at seal time.

PROGRAM issue_12_protocol_calls VERSION 1.0

INPUT
    G.goal = "Implement protocol calls: CALL protocol.name with sealed protocol files"
    C.scope = "src/tikhon/syntax/parser.py, src/tikhon/syntax/model.py, src/tikhon/syntax/__init__.py, src/tikhon/runtime/coordinator.py, tests/test_syntax.py, tests/test_coordinator.py, protocols/framing.think"
    C.done = "CALL grammar parses and seals; validation enforces protocol existence, arg binding, RETURN-subset targets, and acyclic bounded recursion (depth 8); coordinator expands protocol steps inline with prefixed ledger tasks and continuing invocation ids; failing protocol step fails the caller atomically; full pytest suite passes"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.patterns
step.design: DO extract(artifact = E.patterns, schema = "call_node_and_inline_expansion") -> E.design
step.patch: DO summarize(source_refs = E.design, budget = 12000) -> P.patch
step.check: DO check(artifact = P.patch, criteria = C.done) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN P.patch, V.tests, V.result
