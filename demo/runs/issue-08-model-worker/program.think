# Sealed program for GitHub issue #8: model worker adapter with tier-based
# routing (T0-T3). Written in the pre-existing canonical grammar and sealed
# before any source edit (see seal.txt). The adapter this issue adds routes
# command dispatch to tier-configured models behind a transport seam; the
# CI baseline (--worker deterministic) stays byte-for-byte unchanged.

PROGRAM issue_08_model_worker VERSION 1.0

INPUT
    G.goal = "Implement the model worker adapter with tier-based routing T0-T3: a ModelWorker duck-type for DeterministicWorker that builds contract prompts from command specs, dispatches them through a transport seam, parses strict JSON responses, validates them with map_results_to_targets, and wires a --worker model|deterministic CLI flag from TIKHON_* environment configuration"
    C.scope = "src/tikhon/worker_adapter.py, src/tikhon/cli.py, tests/test_worker_adapter.py, demo/runs/issue-08-model-worker/"
    C.done = "Full pytest suite passes with new tests covering tier routing, prompt construction, JSON response parsing, multi-target mapping via map_results_to_targets, CLI guard before run creation, and an end-to-end ModelWorker run through SequentialCoordinator; baseline 484 passed"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.patterns
step.design: DO extract(artifact = E.patterns, schema = "worker_adapter_transport_seam_design") -> V.design
step.patch: DO summarize(source_refs = V.design, budget = 4000) -> P.patch
step.check: DO check(artifact = P.patch, criteria = C.done) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN G.plan, V.tests, V.result
