# Sealed before any source edit for issue #10 (resume: crash-window
# recovery algorithm). Uses only commands registered before this issue;
# the resume machinery itself is exercised after implementation by
# tests/test_resume.py and the CLI end-to-end checks recorded in WORKLOG.md.
PROGRAM issue_10_resume VERSION 1.0

INPUT
    G.goal = "Implement crash-window recovery: resume_run in src/tikhon/resume.py, a crash_hook on SequentialCoordinator.execute, and a tikhon resume CLI subcommand, with at-least-once worker redispatch and append-only event continuation"
    C.scope = "src/tikhon/resume.py, src/tikhon/runtime/coordinator.py, src/tikhon/cli.py, tests/test_resume.py and demo/runs/issue-10-resume/"
    C.done = "resume_run completes crashed runs with gapless seqs, no duplicate SUCCEEDED per invocation, state equal to a normal run's projection, clean audit, already-terminal runs append nothing, and the full pytest suite passes"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.windows
step.design: DO extract(artifact = E.windows, schema = "crash_window_resume_design") -> E.design
step.patch: DO summarize(source_refs = E.design, budget = 4000) -> P.patch
step.apply: DO report(committed_refs = P.patch, format = "python_source") -> ART.patch
step.check: DO check(artifact = ART.patch, predicate = C.done) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN ART.patch, V.tests, V.result
