PROGRAM issue_06_decision_commands VERSION 1.0

INPUT
    G.goal = "Add complete CommandSpec contracts for decompose, hypothesize, compare, rank, challenge, and choose to the builtin registry"
    C.scope = "src/tikhon/registry/builtins.py and tests/test_registry.py"
    C.done = "All six decision commands resolve with complete contracts and the full test suite passes"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.patterns
step.read: DO fetch(resource_refs = E.patterns) -> ART.sources
step.contracts: DO extract(artifact = ART.sources, schema = "command_contract_fields") -> E.fields
step.draft: DO summarize(source_refs = E.fields, budget = 4000) -> P.specs
step.register: DO report(committed_refs = P.specs, format = "python_source") -> ART.registry
step.check: DO check(artifact = ART.registry, criteria = C.done) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN ART.registry, V.tests, V.result
