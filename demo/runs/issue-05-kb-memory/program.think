# Sealed before any source edit for issue #5 (cross-run KB namespace).
# Uses only commands registered before this issue: define, search, fetch,
# extract, summarize, report, check, verify. remember/recall are exercised
# separately in scratch-remember-recall.think after implementation.
PROGRAM issue_05_kb_memory VERSION 1.0

INPUT
    G.goal = "Add cross-run semantic memory to tikhon: KnowledgeBase module, KB. references, remember and recall commands"
    C.scope = "src/tikhon/memory.py, src/tikhon/syntax/parser.py, src/tikhon/registry/builtins.py, src/tikhon/runtime/coordinator.py, src/tikhon/cli.py and matching tests"
    C.done = "remember and recall persist values through a shared kb.sqlite across runs and the full pytest suite passes"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.patterns
step.read: DO fetch(resource_refs = E.patterns) -> ART.sources
step.design: DO extract(artifact = ART.sources, schema = "memory_layer_design") -> E.design
step.patch: DO summarize(source_refs = E.design, budget = 4000) -> P.patch
step.apply: DO report(committed_refs = P.patch, format = "python_source") -> ART.patch
step.check: DO check(artifact = ART.patch, predicate = C.done) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN ART.patch, V.tests, V.result
