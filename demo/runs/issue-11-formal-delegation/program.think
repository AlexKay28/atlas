# Tikhon run for GitHub issue #11: formal-language delegation (solve/prove + FailureKind.FORMALIZATION).

PROGRAM issue_11_formal_delegation VERSION 1.0

INPUT
    G.goal = "Add the formal-language delegation layer: FailureKind.FORMALIZATION plus complete solve and prove command contracts that delegate bounded reasoning to deterministic formal backends"
    C.scope = "src/tikhon/registry/enums.py, src/tikhon/registry/builtins.py, tests/test_registry.py"
    C.behavior = "FailureKind gains the formalization member with value formalization; solve translates a bounded problem to a pddl or smt formalization and returns a deterministic solver result; prove emits a proof artifact in lean4 or isabelle and verifies it with a deterministic checker; both declare formalization as a retryable failure whose recovery requests a new formalization attempt rather than a blind retry; registry-wide invariants cover both new names"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.sites
step.read: DO fetch(resource_refs = E.sites) -> ART.sources
step.analyze: DO extract(artifact = ART.sources, schema = "formal_delegation") -> E.findings
step.design: DO summarize(source_refs = E.findings, budget = 4000) -> P.design
step.patch: DO report(committed_refs = P.design, format = "python_patch") -> ART.patch
step.check: DO check(artifact = ART.patch, criteria = C.behavior) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN ART.patch, V.tests, V.result
