PROGRAM issue-17-reasoning-language VERSION 1.0

INPUT
    G.goal = "Produce docs/design/01-reasoning-language-foundation.md: a design thesis for Tikhon as a formal compact LLM-driven reasoning language, a mechanism table with one row per issue #17 source mapped to existing constructs, a falsifiable experiment register, a tokenizer-grounded notation policy, and explicit non-goals"
    C.scope = "new docs/design/01-reasoning-language-foundation.md; one new document-map row in docs/README.md; protocol artifacts in demo/runs/issue-17-reasoning-language/; no src/, tests/, or other docs/ changes"
    C.done = "all 16 issue #17 source bullets have mechanism rows naming real constructs with syntax sketches verified against src/; 15 numbered falsifiable experiments each with hypothesis, independent and dependent variables, measurement, baseline, and pass/fail threshold; notation policy states a per-model tokenizer test protocol and an interim rule; non-goals section excludes self-modifying grammar and unverifiable heuristics; docs/README.md gains exactly one row; pytest remains 540 passed"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.sources
step.design: DO extract(artifact = E.sources, schema = "mechanism_rows_experiment_register_notation_policy_non_goals") -> E.design
step.produce: DO summarize(source_refs = E.design, budget = 30000) -> ART.doc
step.check: DO check(artifact = ART.doc, criteria = C.done) -> V.checks
step.verify: DO verify(goal = G.goal, evidence = V.checks) -> V.result

RETURN ART.doc, V.checks, V.result
