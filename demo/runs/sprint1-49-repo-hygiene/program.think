# Tikhon run for GitHub issue #49: repo hygiene — pyproject metadata +
# dynamic version, CHANGELOG, CLI reference docs, doc tests.
#
# Sealed BEFORE any source edit (Tikhon protocol step 2). Uses only the
# canonical grammar with registered commands.

PROGRAM sprint1_49_repo_hygiene VERSION 1.0

INPUT
    G.task = "Deliver issue #49 repo hygiene: dynamic version in pyproject.toml via tool.setuptools.dynamic attr tikhon.__version__; add authors, license MIT, classifiers, keywords, project.urls; create CHANGELOG.md in Keep-a-Changelog format with 0.1.0 backfilled from git history and Unreleased listing sprint issues #28-#49; add CLI Reference table to README covering all 13 subcommands from cli.py; fix design doc command count 22 to 23; add or extend a CLI reference page in docs; create tests/test_docs.py verifying subcommand coverage in README, design-doc command count matches registry, and CHANGELOG exists and references registry vocabulary"
    C.scope = "pyproject.toml, CHANGELOG.md (new), README.md, docs/**, tests/test_docs.py (new), demo/runs/sprint1-49-repo-hygiene/"
    C.done = "pyproject.toml has dynamic version from tikhon.__version__, authors, MIT license with license-files, classifiers for Python 3.10-3.13, keywords, project.urls; CHANGELOG.md exists in Keep-a-Changelog format with 0.1.0 and Unreleased sections; README has CLI Reference table with all 13 CLI subcommands; design doc says 23 commands not 22 in both places; tests/test_docs.py passes and full pytest suite stays green at 760+; git status shows only owned files"

step.frame: DO define(request = G.task) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.candidates
step.read: DO fetch(resource_refs = E.candidates) -> ART.sources
step.analyze: DO extract(artifact = ART.sources, schema = "repo_hygiene_findings") -> E.findings
step.decompose: DO decompose(goal = G.plan, protocol = "repo_hygiene") -> G.subgoals
step.hypothesize: DO hypothesize(question = G.task, evidence = E.findings) -> H.theses
step.compare: DO compare(options = H.theses, criteria = C.done) -> V.compared
step.rank: DO rank(options = V.compared, criteria = C.done) -> R.ranked
step.challenge: DO challenge(claim = H.theses, evidence = E.findings) -> V.challenge
step.choose: DO choose(valid_options = R.ranked, evidence = V.challenge) -> D.choice
step.remember: DO remember(key = "sprint1-49-repo-hygiene", value = D.choice) -> K.record
step.recall: DO recall(query = "sprint1-49-repo-hygiene") -> K.recalled
step.solve: DO solve(problem = G.task, domain = "repo_hygiene") -> U.solution
step.prove: DO prove(statement = C.done, language = "tikhon_contract") -> A.proof
step.review: DO review(artifact_refs = ART.sources, focus = "acceptance_evidence") -> V.review
step.summarize: DO summarize(source_refs = V.review, budget = 6000) -> P.design
step.report: DO report(committed_refs = P.design, format = "markdown") -> OUT.solution
step.test: DO test(path = "tests/test_docs.py", timeout_seconds = 120) -> V.tests
step.check: DO check(artifact = V.tests, predicate = "suite_green") -> V.verdict
step.verify: DO verify(goal = G.task, evidence = V.verdict) -> V.result

RETURN P.design, V.verdict, V.result, OUT.solution, A.proof
