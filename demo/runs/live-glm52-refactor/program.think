PROGRAM target_mapping_refactor VERSION 1.0

INPUT
    G.goal = "Extract inline target-mapping logic from SequentialCoordinator.execute into a standalone pure function"
    C.scope = "src/thinklang/runtime/coordinator.py and tests/test_coordinator.py"
    C.behavior = "All existing coordinator tests pass unchanged; new focused tests cover single-target, multi-target-by-full-key, multi-target-by-leaf, non-mapping failure, ambiguous leaf failure, and missing-key failure"

step.investigate: DO search(query = G.goal, scope = C.scope) -> E.candidates
step.read: DO fetch(resource_refs = E.candidates) -> ART.sources
step.analyze: DO extract(artifact = ART.sources, schema = "target_mapping_logic") -> E.findings
step.design: DO summarize(source_refs = E.findings, budget = 4000) -> P.design
step.implement: DO report(committed_refs = P.design, format = "python_patch") -> ART.patch
step.test: DO check(artifact = ART.patch, criteria = C.behavior) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN ART.patch, V.tests, V.result
