# Sealed before any source edit for issue #9 (effectful commands:
# edit, test, review with idempotency keys). Uses only commands registered
# before this issue; edit/test/review are exercised after implementation by
# scratch-edit-test-review.think and the CLI end-to-end tests.
PROGRAM issue_09_effectful_commands VERSION 1.0

INPUT
    G.goal = "Add effectful commands edit, test and review with complete contracts, per-invocation idempotency keys on dispatch, and a workspace-rooted edit handler"
    C.scope = "src/tikhon/registry/builtins.py, src/tikhon/registry/enums.py, src/tikhon/runtime/coordinator.py, src/tikhon/cli.py and matching tests"
    C.done = "edit/test/review contracts registered, every INVOCATION_DISPATCHED payload carries run_id:invocation_id idempotency_key, workspace edits refuse escapes, and the full pytest suite passes"

step.frame: DO define(request = G.goal) -> G.plan
step.locate: DO search(query = G.plan, scope = C.scope) -> E.patterns
step.read: DO fetch(resource_refs = E.patterns) -> ART.sources
step.design: DO extract(artifact = ART.sources, schema = "effectful_command_design") -> E.design
step.patch: DO summarize(source_refs = E.design, budget = 4000) -> P.patch
step.apply: DO report(committed_refs = P.patch, format = "python_source") -> ART.patch
step.check: DO check(artifact = ART.patch, predicate = C.done) -> V.tests
step.verify: DO verify(goal = G.goal, evidence = V.tests) -> V.result

RETURN ART.patch, V.tests, V.result
